# Supabase project settings: Project Settings > API
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Accounts ending in this domain are allowed to sign in
EXPO_PUBLIC_ALLOWED_DOMAIN=hbplus.fit

# Optional: comma-separated non-domain accounts allowed for testing.
# Each one must also be added to private.allowed_test_emails in Supabase.
EXPO_PUBLIC_TEST_EMAILS=
